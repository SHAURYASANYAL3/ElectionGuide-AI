# Internal npm registry endpoint used in CI/dev (example)
NPM_REGISTRY_URL=https://registry.npmjs.org/

# Host portion of the registry URL above (without protocol)
NPM_REGISTRY_HOST=registry.npmjs.org

# Set true only if your internal registry requires auth for all packages
NPM_ALWAYS_AUTH=false

# Optional token for private/internal registries
NPM_TOKEN=
